{%- assign project = include.project -%}
{%- assign target = project.redirect | default: project.url | relative_url -%}

{%- comment -%}
One entry on the projects page: a meta line, the title, the description as a
lede, an optional `summary` in Markdown, a line of links, and any `talks`.
Links are assembled from the dedicated fields first, then from any extra
`links:` entries, so the common cases need no list in the front matter.
{%- endcomment -%}
<article class="entry" data-project data-categories="{{ project.categories | join: '|' | downcase | escape }}">
    <p class="meta">
        {{- project.years | escape -}}
        {%- if project.years and project.venue %} &middot; {% endif -%}
        {{- project.venue | escape -}}
        {%- if project.status and project.status != "" %} &middot; {{ project.status | escape }}{% endif -%}
    </p>
    <h2 class="title"><a href="{{ target }}">{{ project.title | escape }}</a></h2>
    <p class="lede lede--ink">{{ project.description | default: project.sub_title | strip_html | strip }}</p>
    {%- if project.summary %}
    {{ project.summary | markdownify }}
    {%- endif %}
    <p class="meta">
        {%- if project.website %}<a href="{{ project.website }}">Project site &rarr;</a> &middot; {% endif -%}
        {%- if project.github %}<a href="{{ project.github }}">GitHub &rarr;</a> &middot; {% endif -%}
        {%- if project.paper %}<a href="{{ project.paper }}">Paper &rarr;</a> &middot; {% endif -%}
        {%- for link in project.links %}<a href="{{ link.url }}">{{ link.label | escape }} &rarr;</a> &middot; {% endfor -%}
        <a href="{{ target }}">Write-up &rarr;</a>
    </p>
    {%- if project.talks %}
    <div class="entry__talks">
        <p class="meta">Talks</p>
        <ul>
            {%- for talk in project.talks %}
            <li>{{ talk | escape }}</li>
            {%- endfor %}
        </ul>
    </div>
    {%- endif %}
</article>
