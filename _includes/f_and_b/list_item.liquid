{%- assign r = include.item -%}
{%- assign slug = r.slug | default: r.name -%}
{%- assign jr = r.journey_rating | default: 0 -%}
{%- assign pr = r.price_rating | default: 0 -%}

{%- comment -%}
One ruled row: the name with its tier pin on the left, cuisines on the right.
Selecting it opens the place's details beneath the row and moves the map to
it; selecting its marker on the map does the same (_js/map.js, which also
fills in the details panel from the place's data).
{%- endcomment %}
<div class="map-card"
   data-slug="{{ slug | escape }}"
   data-name="{{ r.name | escape }}"
   data-city="{{ r.city | escape }}"
   data-neighborhood="{{ r.neighborhood | escape }}"
   data-country="{{ r.country | escape }}"
   data-journey="{{ jr }}"
   data-price="{{ pr }}"
   data-value="{% if r.value_recognition %}1{% else %}0{% endif %}"
   data-cuisines="{% if r.cuisines %}{{ r.cuisines | join: ' ' | downcase | escape }}{% endif %}">
  <button type="button" class="rows__row map-card__toggle" aria-expanded="false" aria-controls="place-{{ slug | slugify }}">
    <span class="map-card__name">
      {{- r.name | escape -}}
      <span class="journey-pin journey-pin--inline journey-pin--list journey-pin--t{{ jr }}" aria-hidden="true"></span>
      {%- if r.value_recognition -%}<span class="val-badge" title="Exceptional value">&#9672;</span>{%- endif -%}
    </span>
    <span class="rows__note" data-map-card-meta>
      {%- if r.cuisines and r.cuisines.size > 0 -%}
        {{- r.cuisines | join: ", " | replace: "_", " " | capitalize | escape -}}
      {%- endif -%}
    </span>
  </button>
  <div class="row-details" id="place-{{ slug | slugify }}" data-map-card-details hidden></div>
</div>
