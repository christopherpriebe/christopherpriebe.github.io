<head>
    {% include _head/metadata.liquid %}

    <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">

    <link rel="stylesheet" href="{{ '/assets/css/style.css' | relative_url }}">

    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} · Writing" href="{{ '/feed.xml' | relative_url }}">

    <title>
        {% if site.title and page.title %}
            {{ site.title }} - {{ page.title }}
        
        {% elsif page.title %}
            {{ page.title }}
        
        {% elsif site.title %}
            {{ site.title }}
        
        {% else %}
            ERROR: cannot resolve page title
        
        {% endif %}
    </title>
</head>
