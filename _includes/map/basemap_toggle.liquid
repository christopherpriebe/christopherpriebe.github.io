{%- comment -%}Basemap switcher overlay. Wired by _js/basemaps.js.{%- endcomment -%}
<div class="map-overlay map-basemap-toggle seg seg--inline" data-basemap-toggle role="group" aria-label="Base map style">
  <button type="button" class="is-active" data-basemap="osm" aria-pressed="true">Street</button>
  <button type="button" data-basemap="topo" aria-pressed="false">Terrain</button>
</div>
