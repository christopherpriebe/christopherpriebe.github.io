---
layout: base
---

{% comment %} Structure adapted from https://github.com/jglovier/resume-template/ {% endcomment %}

{%- capture resume_name %}{{ site.profile.first_name }}{% if site.profile.middle_name %} {{ site.profile.middle_name }}{% endif %} {{ site.profile.last_name }}{% endcapture -%}
{%- capture resume_meta %}{{ site.resume_title }} &middot; {% include email_link.liquid %}{% endcapture -%}
{% include page_title.liquid title=resume_name lede=site.resume_executive_summary lede_ink=true meta=resume_meta %}

{%- assign educations = site.resume | where: "type", "education" | sort: "order" -%}
{%- assign experiences = site.resume | where: "type", "experience" | sort: "order" -%}

{%- if site.resume_section_education %}
<section class="resume-section">
    <h2 class="label">Education</h2>
    {%- for education in educations %}
        {%- if education.show %}
    <div class="resume-item">
        <p class="meta">{{ education.duration }}</p>
        <h3 class="title">{{ education.name }}</h3>
        <p>{{ education.degree }}</p>
        {%- if education.items %}
        <ul>
            {%- for item in education.items %}
            <li>{{ item[0] }}: {{ item[1] }}</li>
            {%- endfor %}
        </ul>
        {%- endif %}
        {{ education.content }}
    </div>
        {%- endif %}
    {%- endfor %}
</section>
{%- endif %}

{%- if site.resume_section_experience %}
<section class="resume-section">
    <h2 class="label">Experience</h2>
    {%- for experience in experiences %}
        {%- if experience.show %}
    <div class="resume-item">
        <p class="meta">{{ experience.duration }}</p>
        <h3 class="title">{{ experience.organization_name }}</h3>
        <p>{{ experience.position_name }}</p>
        {{ experience.content }}
    </div>
        {%- endif %}
    {%- endfor %}
</section>
{%- endif %}
