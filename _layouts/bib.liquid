{% comment %} Inspired (i.e., copied and slightly modified) by https://github.com/alshedivat/al-folio {% endcomment %}

{%- comment -%}
One publication: a meta line naming the venue and year, the title, the
author list, and a row of link buttons (and the abstract toggle) beneath it.
An entry goes by its `abbr` where one is set, whatever its type; otherwise
@misc entries read as preprints, and the rest take their journal or
booktitle.
{%- endcomment -%}
{%- if entry.abbr -%}
    {%- assign venue = entry.abbr | append: " " | append: entry.year -%}
{%- elsif entry.type == "misc" -%}
    {%- assign venue = "Preprint, " | append: entry.year -%}
{%- elsif entry.journal -%}
    {%- assign venue = entry.journal | append: ", " | append: entry.year -%}
{%- elsif entry.booktitle -%}
    {%- assign venue = entry.booktitle | append: ", " | append: entry.year -%}
{%- else -%}
    {%- assign venue = entry.year -%}
{%- endif -%}

{%- comment -%}
The venue links to its page in _data/venues.yaml: that year's edition if
listed, else the venue's own site.
{%- endcomment -%}
{%- assign venue_url = nil -%}
{%- if entry.abbr and site.data.venues[entry.abbr] -%}
    {%- assign venue_data = site.data.venues[entry.abbr] -%}
    {%- assign venue_year = entry.year | append: "" -%}
    {%- assign venue_url = venue_data.years[venue_year] | default: venue_data.url -%}
{%- endif -%}

<article class="entry" id="{{ entry.key }}">
    <p class="meta entry__venue">
        {%- if venue_url -%}<a href="{{ venue_url }}">{{ venue }}</a>{%- else -%}{{ venue }}{%- endif -%}
    </p>

    <h2 class="title">{{ entry.title }}</h2>

    <p class="entry__authors">
        {%- assign author_array_size = entry.author_array | size -%}
        {%- assign author_array_limit = author_array_size -%}
        {%- if site.max_author_limit and author_array_size > site.max_author_limit -%}
            {%- assign author_array_limit = site.max_author_limit -%}
        {%- endif -%}

        {%- for author in entry.author_array limit: author_array_limit -%}
            {%- assign author_is_self = false -%}
            {%- assign author_last_name = author.last | regex_replace: "[*∗†‡§¶‖&^]", "" -%}
            {%- assign author_last_html = author.last | regex_replace: "([*∗†‡§¶‖&^]+)", "<sup>\1</sup>" -%}
            {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
                {%- assign author_is_self = true -%}
            {%- endif -%}
            {%- assign coauthor_url = null -%}
            {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
            {%- if site.data.coauthors[clean_last_name] -%}
                {%- for coauthor in site.data.coauthors[clean_last_name] -%}
                    {%- if coauthor.first_name contains author.first -%}
                        {%- assign coauthor_url = coauthor.url -%}
                        {%- break -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {%- unless forloop.first -%}, {% endunless -%}
            {%- if author_is_self -%}
                <span class="self">{{ author.first }} {{ author_last_html }}</span>
            {%- elsif coauthor_url -%}
                <a href="{{ coauthor_url }}">{{- author.first }} {{ author_last_html -}}</a>
            {%- else -%}
                {{- author.first }} {{ author_last_html -}}
            {%- endif -%}
        {%- endfor -%}
        {%- if author_array_limit < author_array_size %}, et al.{% endif -%}
    </p>


    <div class="seg seg--inline entry__links">
        {%- if entry.arxiv %}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>
        {%- endif -%}
        {%- if entry.pdf %}
        <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">PDF</a>
        {%- endif -%}
        {%- if entry.html -%}
            {%- if entry.html contains "://" %}
        <a href="{{ entry.html }}">HTML</a>
            {%- else %}
        <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}">HTML</a>
            {%- endif -%}
        {%- endif -%}
        {%- if entry.abstract %}
        <button type="button" aria-expanded="false" aria-controls="abs-{{ entry.key }}" data-abstract-toggle>Abstract</button>
        {%- endif %}
    </div>

    {%- if entry.abstract %}
    <p class="entry__abstract" id="abs-{{ entry.key }}" hidden>{{ entry.abstract }}</p>
    {%- endif %}
</article>
