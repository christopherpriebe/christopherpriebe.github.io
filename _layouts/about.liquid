---
layout: base
---

{%- comment -%}
The text runs down the usual left column and the portrait stands to its
right, its top level with the title. On narrow screens the portrait drops in
between the title and the text.
{%- endcomment -%}
<div class="about{% if page.headshot %} about--portrait{% endif %}">
    <div class="page-head measure about__head">
        <h1 class="page-title">{{ page.title }}</h1>
    </div>

    {%- if page.headshot -%}
        {%- assign headshot_alt = page.headshot_alt | default: "Portrait of Christopher Priebe" %}
    {% include photo.liquid src=page.headshot alt=headshot_alt caption=page.headshot_caption shape="portrait" class="about__portrait" loading="eager" %}
    {%- endif %}

    <div class="about__body">
        <div class="prose prose--lede about-body">
            {{ content }}
        </div>

        <p class="meta measure about-contact">
            {% include email_link.liquid %} &middot; <a href="{{ '/cv/' | relative_url }}">CV</a>
        </p>
    </div>
</div>
