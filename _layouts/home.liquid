---
layout: base
---

<section class="hero">
    <h1 class="display">{{ site.profile.first_name }} {{ site.profile.last_name }}</h1>
    <p class="lede">{{ page.lede }}</p>
    <p class="meta"><a href="{{ '/about/' | relative_url }}">More about me &rarr;</a></p>
</section>

{%- comment -%}
One hairline per row and 36px of air either side. The count sits at the end
of the row as plain text rather than in a badge.
{%- endcomment -%}
<nav class="home-index" aria-label="Sections">
    <div class="rows rows--index">
        {%- for row in page.index -%}
            {%- assign note = row.note -%}
            {%- case row.count -%}
                {%- when "publications" -%}
                    {%- capture n %}{% bibliography_count %}{% endcapture -%}
                    {%- capture note %}{% include number_word.liquid n=n %} paper{% if n != "1" %}s{% endif %}{% endcapture -%}
                {%- when "projects" -%}
                    {%- if site.projects.size == 1 -%}
                        {%- assign note = site.projects.first.title -%}
                    {%- else -%}
                        {%- capture note %}{% include number_word.liquid n=site.projects.size %} projects{% endcapture -%}
                    {%- endif -%}
                {%- when "posts" -%}
                    {%- capture note %}{% include number_word.liquid n=site.posts.size %} post{% if site.posts.size != 1 %}s{% endif %}{% endcapture -%}
                {%- when "places" -%}
                    {%- assign n = site.data.f_and_b_establishments.size -%}
                    {%- capture note %}{% include number_word.liquid n=n %} place{% if n != 1 %}s{% endif %}{% endcapture -%}
                {%- when "routes" -%}
                    {%- assign n = site.data.running_routes.size -%}
                    {%- capture note %}{% include number_word.liquid n=n %} route{% if n != 1 %}s{% endif %}{% endcapture -%}
            {%- endcase %}
        <a class="rows__row" href="{{ row.url | relative_url }}">
            <span class="rows__title">{{ row.title | escape }}</span>
            <span class="rows__note">{{ note }}</span>
        </a>
        {%- endfor %}
    </div>
</nav>

{%- assign history = site.history | sort: "start_year" | reverse %}
<section class="timeline-wrap" aria-label="Education">
    <div class="timeline">
        {%- for item in history %}
        <div class="timeline__item">
            <div class="timeline__when">{{ item.start_year }} &ndash; {{ item.end_year | default: "present" }}</div>
            <div>
                <h2 class="title">{{ item.title }}</h2>
                {{ item.content }}
            </div>
        </div>
        {%- endfor %}
    </div>
</section>

<section class="hello">
    <p class="lede">Say hello &mdash; {% include email_link.liquid %}</p>
    <p class="meta"><a href="{{ '/connect/' | relative_url }}">Elsewhere &rarr;</a></p>
</section>
