---
layout: base
---

{%- capture lede %}Email is best &mdash; <a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endcapture -%}
{% include page_title.liquid lede=lede lede_ink=true %}

<div class="rows rows--links measure connect-rows">
    {%- for social in site.data.socials %}
    <a class="rows__row" href="{{ social[1].url }}">
        <span>{{ social[1].name | escape }}</span>
        <span class="rows__note">{{ social[1].handle | escape }}</span>
    </a>
    {%- endfor %}
</div>
