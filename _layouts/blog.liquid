---
layout: base
---

{%- assign posts = site.posts -%}
{%- assign latest = posts | first -%}
{%- assign rest = posts | slice: 1, 999 -%}
{%- if posts.size < 2 -%}{%- assign rest = "" | split: "," -%}{%- endif -%}
{%- assign topics = posts | map: "tags" | compact | join: "," | split: "," | uniq | sort -%}

<div class="container">
    <div class="col-xs-12">
        {% include page_title.liquid %}

        {%- if topics.size > 1 -%}
            {% include filter_bar.liquid scope="posts" label="Topic" values=topics count=posts.size noun="posts" %}
        {%- endif -%}

        {%- if latest -%}
            <article class="latest" data-post data-categories="{{ latest.tags | join: '|' | downcase | escape }}">
                <div class="latest__top">
                    <span class="latest__label">Latest</span>
                    <span class="latest__date">
                        {{ latest.date | date: "%B %-d, %Y" }} &middot; {% include reading_time.liquid content=latest.content %}
                    </span>
                </div>
                <h2 class="latest__title"><a href="{{ latest.url | relative_url }}">{{ latest.title | escape }}</a></h2>
                <p class="latest__dek">{% include post_excerpt.liquid post=latest %}</p>
                <div class="latest__foot">
                    {%- for tag in latest.tags -%}
                        <span class="tag-pill">{{ tag | escape }}</span>
                    {%- endfor -%}
                    <a class="latest__read" href="{{ latest.url | relative_url }}">Read the post &rarr;</a>
                </div>
            </article>
        {%- endif -%}

        {%- assign years = rest | group_by_exp: "post", "post.date | date: '%Y'" -%}
        {%- for year in years -%}
            <div class="arch__year" data-archive-year>
                <b>{{ year.name }}</b>
                <i></i>
                <em>{{ year.items | size }} post{% if year.items.size != 1 %}s{% endif %}</em>
            </div>
            {%- for post in year.items -%}
                <article class="post" data-post data-categories="{{ post.tags | join: '|' | downcase | escape }}">
                    <div class="post__when">
                        {{ post.date | date: "%b %-d" }}
                        <small>{% include reading_time.liquid content=post.content %}</small>
                    </div>
                    <div>
                        <h3 class="post__title"><a href="{{ post.url | relative_url }}">{{ post.title | escape }}</a></h3>
                        <p class="post__dek">{% include post_excerpt.liquid post=post %}</p>
                        <div class="post__tags">
                            {%- for tag in post.tags -%}
                                <span class="tag-pill">{{ tag | escape }}</span>
                            {%- endfor -%}
                        </div>
                    </div>
                </article>
            {%- endfor -%}
        {%- endfor -%}

        <p class="filters__empty" data-filter-empty>No post matches that topic.</p>

        {%- if posts.size == 0 -%}
            <p class="text-muted">No posts yet.</p>
        {%- endif -%}

        <div class="blog-foot">
            <p>Posts are also available over <a href="{{ '/feed.xml' | relative_url }}">RSS</a>.</p>
        </div>
    </div>
</div>
